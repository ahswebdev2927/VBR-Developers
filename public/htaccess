# 1. Error Handling
ErrorDocument 404 /404.html

# 2. HTTPS Redirection & 3. Trailing Slash Normalization
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ensure directory URLs map with trailing slash to serve index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(/$)
  RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]
</IfModule>

# 4. Caching & Performance
<IfModule mod_headers.c>
  # Do not cache HTML so visitors instantly see new deployments
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Images: Cache for 1 day with revalidation (safe for updates/edits)
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  # Next.js static hashed bundles and web fonts
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, must-revalidate"
  </FilesMatch>
</IfModule>
